{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/dsh-alpha1-runtime-receipt-set-v1.json",
  "title": "DSH alpha.1 six-task runtime receipt set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "source", "workflow", "requiredReceiptCount", "receipts", "provenanceSetSha256", "receiptSetPayloadSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "alpha1-runtime-matrix-verified" },
    "source": { "$ref": "runtime-receipt.schema.json#/$defs/source" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflowPath", "workflowSha256", "runId", "runAttempt", "headSha"],
      "properties": {
        "repository": { "const": "LvvUP/dsh-themes-skills" },
        "workflowPath": { "const": ".github/workflows/alpha1-runtime-certification.yml" },
        "workflowSha256": { "$ref": "#/$defs/sha256" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "runAttempt": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "headSha": { "$ref": "#/$defs/sha1" }
      }
    },
    "requiredReceiptCount": { "const": 6 },
    "receipts": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/receiptEntry" } },
    "provenanceSetSha256": { "$ref": "#/$defs/sha256" },
    "receiptSetPayloadSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "receiptEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch", "nodeVersion", "receiptSha256", "jobId"],
      "properties": {
        "platform": { "enum": ["linux", "darwin", "win32"] },
        "arch": { "enum": ["x64", "arm64"] },
        "nodeVersion": { "enum": ["22.19.0", "24.15.0"] },
        "receiptSha256": { "$ref": "#/$defs/sha256" },
        "jobId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$" }
      }
    }
  }
}
