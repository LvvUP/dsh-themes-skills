{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/dsh-alpha2-source-build-receipt-v1.json",
  "title": "DSH alpha.2 local source-build receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "scope",
    "source",
    "toolchain",
    "result",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "local-source-build-passed" },
    "scope": { "const": "one-machine-local-build-only" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit", "tree", "lockfileSha256"],
      "properties": {
        "tag": { "const": "dsh-v0.1.2-alpha.2" },
        "commit": { "const": "0a53fb55bea101816fa226bb964ae2bed71c343b" },
        "tree": { "const": "64ccbfa8e0caa4711cd4a75717ef9e022657961b" },
        "lockfileSha256": { "const": "6cc109a574218f51762474455c8d72e5f7c2625aedf25e85569dba1af7adcef0" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch", "nodeVersion", "packageManager", "packageManagerVersion"],
      "oneOf": [
        { "properties": { "platform": { "const": "linux" }, "arch": { "const": "x64" } } },
        { "properties": { "platform": { "const": "darwin" }, "arch": { "const": "arm64" } } },
        { "properties": { "platform": { "const": "win32" }, "arch": { "const": "x64" } } }
      ],
      "properties": {
        "platform": { "enum": ["linux", "darwin", "win32"] },
        "arch": { "enum": ["x64", "arm64"] },
        "nodeVersion": { "enum": ["22.19.0", "24.15.0"] },
        "packageManager": { "const": "pnpm" },
        "packageManagerVersion": { "const": "11.7.0" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildScript", "builtCliPath", "builtCliSha256", "reportedVersion", "pathInstalled"],
      "properties": {
        "buildScript": { "const": "build:official" },
        "builtCliPath": { "const": "apps/cli/lib/bin.js" },
        "builtCliSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reportedVersion": { "const": "0.1.2-alpha.2" },
        "pathInstalled": { "const": false }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturesProcessOutput", "capturesEnvironment", "capturesBrowserCredentials", "capturesCredentialDerivedDigest"],
      "properties": {
        "capturesProcessOutput": { "const": false },
        "capturesEnvironment": { "const": false },
        "capturesBrowserCredentials": { "const": false },
        "capturesCredentialDerivedDigest": { "const": false }
      }
    }
  }
}
