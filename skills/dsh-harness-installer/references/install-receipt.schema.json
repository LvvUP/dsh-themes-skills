{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/dsh-alpha2-official-npm-install-receipt-v1.json",
  "title": "DSH alpha.2 official npm versioned-install receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "scope",
    "package",
    "resolution",
    "toolchain",
    "result",
    "provenanceBoundary",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "official-npm-install-passed" },
    "scope": { "const": "one-machine-versioned-user-install" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "distIntegrity", "tarballSha256", "cliSha256"],
      "properties": {
        "name": { "const": "@deepseek-ai/dsh" },
        "version": { "const": "0.1.2-alpha.2" },
        "distIntegrity": {
          "const": "sha512-4TvTC5kRKlgtSU2UTBv+cID9a2Z+6+m6mpvjXWJfVzuTkflCff6s4MsQpFJTCmwFh/k7zNWe7qFXcLYMV/5VvA=="
        },
        "tarballSha256": {
          "const": "5bf062a26a490853ffb9294fe3c9fb2047f029be3545612dea45718a81920a47"
        },
        "cliSha256": {
          "const": "dc23f6c5dd7df8834e3e38bdb9609d77b459834681ae9b7133b417b0c35f3166"
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lockfileSha256", "frozenLockfile", "lifecycleScriptsRun", "peerPolicy"],
      "properties": {
        "lockfileSha256": {
          "const": "083152c5eaf99bd2ecad3db1b5a04aca2141b5347e7db97caca82e0ce5a09b1c"
        },
        "frozenLockfile": { "const": true },
        "lifecycleScriptsRun": { "const": false },
        "peerPolicy": { "const": "upstream-compatible-locked-resolution" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch", "nodeVersion", "packageManager", "packageManagerVersion"],
      "oneOf": [
        { "properties": { "platform": { "const": "linux" }, "arch": { "const": "x64" } } },
        { "properties": { "platform": { "const": "darwin" }, "arch": { "const": "arm64" } } },
        { "properties": { "platform": { "const": "win32" }, "arch": { "const": "x64" } } }
      ],
      "properties": {
        "platform": { "enum": ["linux", "darwin", "win32"] },
        "arch": { "enum": ["x64", "arm64"] },
        "nodeVersion": { "enum": ["22.19.0", "24.15.0"] },
        "packageManager": { "const": "pnpm" },
        "packageManagerVersion": { "const": "11.7.0" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installedCliPath", "installedCliSha256", "reportedVersion", "pathInstalled", "versionedDirectory"],
      "properties": {
        "installedCliPath": { "const": "node_modules/@deepseek-ai/dsh/lib/bin.js" },
        "installedCliSha256": {
          "const": "dc23f6c5dd7df8834e3e38bdb9609d77b459834681ae9b7133b417b0c35f3166"
        },
        "reportedVersion": { "const": "0.1.2-alpha.2" },
        "pathInstalled": { "const": false },
        "versionedDirectory": { "const": true }
      }
    },
    "provenanceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npmGitHeadPresent", "npmProvenanceAttestationPresent", "sourceCommitBoundToNpmArtifact", "binarySourceEquivalenceClaimed"],
      "properties": {
        "npmGitHeadPresent": { "const": false },
        "npmProvenanceAttestationPresent": { "const": false },
        "sourceCommitBoundToNpmArtifact": { "const": false },
        "binarySourceEquivalenceClaimed": { "const": false }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturesProcessOutput", "capturesEnvironment", "capturesBrowserCredentials", "capturesCredentialDerivedDigest", "capturesInstallPath"],
      "properties": {
        "capturesProcessOutput": { "const": false },
        "capturesEnvironment": { "const": false },
        "capturesBrowserCredentials": { "const": false },
        "capturesCredentialDerivedDigest": { "const": false },
        "capturesInstallPath": { "const": false }
      }
    }
  }
}
