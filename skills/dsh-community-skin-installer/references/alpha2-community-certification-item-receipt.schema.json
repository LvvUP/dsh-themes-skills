{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/community-alpha2-certification-item-receipt-v1.json",
  "title": "One DSH community skin alpha.2 six-task candidate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "scope",
    "reviewStatus",
    "authorityMutation",
    "installability",
    "certificationPlanSha256",
    "authority",
    "baseline",
    "run",
    "item",
    "gate",
    "tasks",
    "candidateDisposition"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": {
      "enum": [
        "community-alpha2-item-candidate-passed",
        "community-alpha2-item-candidate-failed"
      ]
    },
    "scope": { "const": "one-community-skin-six-task-candidate" },
    "reviewStatus": { "const": "pending-review" },
    "authorityMutation": { "const": false },
    "installability": { "const": "none" },
    "certificationPlanSha256": { "$ref": "#/$defs/sha256" },
    "authority": { "$ref": "#/$defs/authority" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "run": { "$ref": "#/$defs/run" },
    "item": { "$ref": "#/$defs/item" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredTasks",
        "completedTasks",
        "passedTasks",
        "failedTasks",
        "rollbackVerifiedTasks",
        "taskOutcomePassed"
      ],
      "properties": {
        "requiredTasks": { "const": 6 },
        "completedTasks": { "const": 6 },
        "passedTasks": { "type": "integer", "minimum": 0, "maximum": 6 },
        "failedTasks": { "type": "integer", "minimum": 0, "maximum": 6 },
        "rollbackVerifiedTasks": { "const": 6 },
        "taskOutcomePassed": { "type": "boolean" }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/taskSummary" }
    },
    "candidateDisposition": {
      "enum": [
        "eligible-awaiting-review",
        "ineligible-task-failure",
        "ineligible-cohort-blocked"
      ]
    }
  },
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentGateSha256",
        "catalogSha256",
        "harnessAuthoritySha256"
      ],
      "properties": {
        "currentGateSha256": { "$ref": "#/$defs/sha256" },
        "catalogSha256": { "$ref": "#/$defs/sha256" },
        "harnessAuthoritySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineId",
        "packageVersion",
        "tag",
        "commit",
        "tree",
        "officialNpmTarballSha256"
      ],
      "properties": {
        "baselineId": {
          "const": "deepseek-harness/dsh-v0.1.2-alpha.2@0a53fb55bea101816fa226bb964ae2bed71c343b"
        },
        "packageVersion": { "const": "0.1.2-alpha.2" },
        "tag": { "const": "dsh-v0.1.2-alpha.2" },
        "commit": {
          "const": "0a53fb55bea101816fa226bb964ae2bed71c343b"
        },
        "tree": {
          "const": "64ccbfa8e0caa4711cd4a75717ef9e022657961b"
        },
        "officialNpmTarballSha256": {
          "const": "5bf062a26a490853ffb9294fe3c9fb2047f029be3545612dea45718a81920a47"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "workflow",
        "workflowSha256",
        "event",
        "ref",
        "runId",
        "runAttempt",
        "headSha"
      ],
      "properties": {
        "repository": { "const": "LvvUP/dsh-themes-skills" },
        "workflow": { "const": "alpha2-community-skin-certification" },
        "workflowSha256": { "$ref": "#/$defs/sha256" },
        "event": { "const": "workflow_dispatch" },
        "ref": { "const": "refs/heads/main" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "runAttempt": { "type": "integer", "minimum": 1, "maximum": 100 },
        "headSha": { "$ref": "#/$defs/sha40" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "bytes", "sha256"],
      "properties": {
        "kind": {
          "enum": ["skin-center-shared-npm-tarball", "bundled-user-skin"]
        },
        "locator": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogId",
        "slug",
        "skinId",
        "installationMode",
        "sourceRepository",
        "sourceRevision",
        "sourceSubdir",
        "cohortId",
        "artifact"
      ],
      "properties": {
        "catalogId": { "type": "integer", "minimum": 1000, "maximum": 9999 },
        "slug": { "type": "string" },
        "skinId": { "type": "string" },
        "installationMode": {
          "enum": ["skin-center-builtin", "bundled-user-skin"]
        },
        "sourceRepository": { "type": "string" },
        "sourceRevision": { "$ref": "#/$defs/sha40" },
        "sourceSubdir": { "type": "string" },
        "cohortId": { "type": "string" },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "taskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "tuple",
        "status",
        "terminalReason",
        "receiptSha256"
      ],
      "properties": {
        "taskId": { "type": "string" },
        "tuple": { "type": "string" },
        "status": {
          "enum": [
            "community-alpha2-task-passed",
            "community-alpha2-task-failed"
          ]
        },
        "terminalReason": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            { "type": "null" }
          ]
        },
        "receiptSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
