{
  "name": "@anionex/dsh-computer-use",
  "version": "0.3.2-dsh.alpha.2",
  "description": "Accessibility-first macOS Computer Use capability for DeepSeek Harness with stale-observation protection, app leases, confirmations, screenshots, and Web diagnostics",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "computer-use",
    "macos",
    "accessibility",
    "desktop-automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anionex/dsh-computer-use.git"
  },
  "bugs": {
    "url": "https://github.com/Anionex/dsh-computer-use/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./service": {
      "types": "./lib/types/service.d.ts",
      "default": "./lib/service.js"
    },
    "./provider-macos": {
      "types": "./lib/types/providers/macos.d.ts",
      "default": "./lib/providers/macos.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "native/macos/Sources",
    "native/macos/bin",
    "native/macos/manifest.json",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "ALPHA.md",
    "licenses"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.1.3-alpha.1",
      "profiles": [
        "web"
      ],
      "note": "Fixed source adaptation; runtime verification is recorded separately."
    }
  },
  "license": "MIT"
}
