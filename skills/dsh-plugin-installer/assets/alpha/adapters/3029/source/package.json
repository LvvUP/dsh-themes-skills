{
  "name": "dsh-session-tree",
  "version": "0.2.0-beta.1-dsh.alpha.1",
  "description": "Lightweight read-only session lineage navigation for DeepSeek Harness",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "session-lineage",
    "conversation",
    "typescript"
  ],
  "homepage": "https://github.com/ZhengQingJing/dsh-session-tree",
  "bugs": {
    "url": "https://github.com/ZhengQingJing/dsh-session-tree/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhengQingJing/dsh-session-tree.git"
  },
  "author": {
    "name": "ZhengQingJing",
    "url": "https://github.com/ZhengQingJing"
  },
  "contributors": [
    {
      "name": "ZeXin Lin",
      "url": "https://github.com/webDrag0n"
    }
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "src",
    "LICENSE",
    "README.md",
    "README.en.md",
    "ADAPTATION.md",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
