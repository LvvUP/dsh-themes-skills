{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/dsh-plugin-alpha2-replacement-id-proposal-v1.json",
  "title": "Non-installing deterministic replacement Public ID proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "authorityEffect",
    "installable",
    "writesPluginAuthorityItems",
    "migrationMapSha256",
    "runtimePlanSha256",
    "receiptSetSha256",
    "firstPublicId",
    "allocationCount",
    "retiredIdsMayBeRebound",
    "entriesSha256",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "deterministic-id-allocation-proposal" },
    "authorityEffect": { "const": "proposal-only-never-install-authority" },
    "installable": { "const": false },
    "writesPluginAuthorityItems": { "const": false },
    "migrationMapSha256": { "$ref": "#/$defs/sha256" },
    "runtimePlanSha256": { "$ref": "#/$defs/sha256" },
    "receiptSetSha256": { "$ref": "#/$defs/sha256" },
    "firstPublicId": { "const": 3089 },
    "allocationCount": { "const": 28 },
    "retiredIdsMayBeRebound": { "const": false },
    "entriesSha256": { "$ref": "#/$defs/sha256" },
    "entries": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:#[A-Za-z0-9_./-]+)?$"
    },
    "candidateToken": {
      "type": "string",
      "pattern": "^replacement-(?:0[1-9]|[1-3][0-9]|4[0-4])-[a-f0-9]{20}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposedPublicId",
        "migrationRank",
        "candidateKey",
        "candidateToken",
        "packageName",
        "packageVersion",
        "distributionClass",
        "distributionDisposition",
        "exactSourceCoordinate",
        "sixTaskReceiptSetSha256"
      ],
      "properties": {
        "proposedPublicId": { "type": "integer", "minimum": 3089, "maximum": 3116 },
        "migrationRank": { "type": "integer", "minimum": 1, "maximum": 44 },
        "candidateKey": { "$ref": "#/$defs/candidateKey" },
        "candidateToken": { "$ref": "#/$defs/candidateToken" },
        "packageName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "packageVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "distributionClass": {
          "enum": ["direct-upstream-exact", "hosted-adaptation-required"]
        },
        "distributionDisposition": {
          "enum": [
            "exact-upstream-candidate-only",
            "hosted-adaptation-candidate-only"
          ]
        },
        "exactSourceCoordinate": { "type": "string", "minLength": 3, "maxLength": 500 },
        "sixTaskReceiptSetSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
