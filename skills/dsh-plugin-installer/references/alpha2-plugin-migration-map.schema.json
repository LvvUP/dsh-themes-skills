{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/dsh-plugin-alpha2-migration-map-v1.json",
  "title": "DSH alpha.2 plugin migration map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capturedAt",
    "purpose",
    "baseline",
    "awesomeSnapshot",
    "publication",
    "counts",
    "idPolicy",
    "directPinRetained",
    "hostedAdaptationRetained",
    "retired",
    "replacementCandidates"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capturedAt": { "type": "string", "format": "date" },
    "purpose": { "const": "dsh-plugin-alpha2-static-migration-evidence" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit", "tree", "removedPackages"],
      "properties": {
        "tag": { "const": "dsh-v0.1.2-alpha.2" },
        "commit": { "const": "0a53fb55bea101816fa226bb964ae2bed71c343b" },
        "tree": { "const": "64ccbfa8e0caa4711cd4a75717ef9e022657961b" },
        "removedPackages": {
          "const": [
            "@deepseek-ai/dsh-client-runtime",
            "@deepseek-ai/dsh-host-apiproxy"
          ]
        }
      }
    },
    "awesomeSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": {
          "const": "https://github.com/awesome-dsh-plugin/awesome-dsh-plugin.git"
        },
        "commit": { "const": "db181e1aed39ad4a041cb9d379f0d713edfc49bb" },
        "tree": { "const": "24c75117d9fe59fd832359c7ef2ab14632fd543d" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "installable", "runtimeCertifiedCount"],
      "properties": {
        "status": { "const": "static-reviewed-pending-runtime" },
        "installable": { "const": false },
        "runtimeCertifiedCount": { "const": 0 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedRejected",
        "directPinRetained",
        "hostedAdaptationRetained",
        "retired",
        "replacementCandidates",
        "replacementDirectUpstream",
        "replacementHostedAdaptation"
      ],
      "properties": {
        "reviewedRejected": { "const": 44 },
        "directPinRetained": { "const": 6 },
        "hostedAdaptationRetained": { "const": 10 },
        "retired": { "const": 28 },
        "replacementCandidates": { "const": 44 },
        "replacementDirectUpstream": { "const": 35 },
        "replacementHostedAdaptation": { "const": 9 }
      }
    },
    "idPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstEligibleReplacementCatalogId",
        "idsToIssueAfterCertification",
        "allocateOnlyAfterSixTaskRuntimePass",
        "neverRebindRetiredIds",
        "candidatePublicIdsAllocated"
      ],
      "properties": {
        "firstEligibleReplacementCatalogId": { "const": 3089 },
        "idsToIssueAfterCertification": { "const": 28 },
        "allocateOnlyAfterSixTaskRuntimePass": { "const": true },
        "neverRebindRetiredIds": { "const": true },
        "candidatePublicIdsAllocated": { "const": false }
      }
    },
    "directPinRetained": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/legacyDecision" }
    },
    "hostedAdaptationRetained": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/legacyDecision" }
    },
    "retired": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": { "$ref": "#/$defs/legacyDecision" }
    },
    "replacementCandidates": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "items": { "$ref": "#/$defs/replacementCandidate" }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"
    },
    "sourceSubdir": {
      "type": "string",
      "pattern": "^(?:\\.|[A-Za-z0-9_-]+(?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:/[A-Za-z0-9_-]+(?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*)$"
    },
    "legacyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogId",
        "repository",
        "commit",
        "tree",
        "packageCoordinate",
        "decision",
        "staticReviewStatus",
        "runtimeStatus",
        "reasonCodes"
      ],
      "properties": {
        "catalogId": { "type": "integer", "minimum": 3000, "maximum": 3088 },
        "repository": { "$ref": "#/$defs/repository" },
        "commit": { "$ref": "#/$defs/sha" },
        "tree": { "$ref": "#/$defs/sha" },
        "packageCoordinate": { "type": "string", "minLength": 3, "maxLength": 160 },
        "decision": {
          "enum": ["retain-direct-pin", "retain-hosted-adaptation", "retire-permanently"]
        },
        "staticReviewStatus": { "const": "static-reviewed" },
        "runtimeStatus": { "const": "pending-runtime" },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "alpha2-surface-clean",
              "removed-client-runtime-import",
              "removed-host-apiproxy-import",
              "bundle-missing",
              "hosted-rewrite-bounded",
              "retirement-selected"
            ]
          }
        }
      }
    },
    "upstreamInstall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "direct", "exactCoordinate"],
      "properties": {
        "mode": {
          "enum": ["npm-exact", "github-release-exact", "hosted-adaptation-required"]
        },
        "direct": { "type": "boolean" },
        "exactCoordinate": { "type": "string", "minLength": 3, "maxLength": 300 }
      }
    },
    "qualitySignals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starsAtReview", "summary"],
      "properties": {
        "starsAtReview": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string", "minLength": 3, "maxLength": 240 }
      }
    },
    "replacementCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "candidateKey",
        "repository",
        "sourceSubdir",
        "commit",
        "tree",
        "licenseExpression",
        "category",
        "packageName",
        "packageVersion",
        "distributionClass",
        "upstreamInstall",
        "staticReviewStatus",
        "runtimeStatus",
        "alpha2SurfaceAssessment",
        "qualitySignals"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 44 },
        "candidateKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:#[A-Za-z0-9_./-]+)?$"
        },
        "repository": { "$ref": "#/$defs/repository" },
        "sourceSubdir": { "$ref": "#/$defs/sourceSubdir" },
        "commit": { "$ref": "#/$defs/sha" },
        "tree": { "$ref": "#/$defs/sha" },
        "licenseExpression": { "type": "string", "minLength": 2, "maxLength": 80 },
        "category": {
          "enum": [
            "developer-tools",
            "documentation",
            "identity",
            "market-data",
            "memory",
            "model-routing",
            "notifications",
            "security",
            "sessions",
            "skills",
            "usage",
            "vision",
            "voice",
            "web-ui",
            "workflow"
          ]
        },
        "packageName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "packageVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "distributionClass": {
          "enum": ["direct-upstream-exact", "hosted-adaptation-required"]
        },
        "upstreamInstall": { "$ref": "#/$defs/upstreamInstall" },
        "staticReviewStatus": { "const": "static-reviewed" },
        "runtimeStatus": { "const": "pending-runtime" },
        "alpha2SurfaceAssessment": {
          "enum": [
            "no-removed-package-imports-found",
            "removed-package-imports-require-adaptation",
            "artifact-gap-requires-adaptation"
          ]
        },
        "qualitySignals": { "$ref": "#/$defs/qualitySignals" }
      }
    }
  }
}
