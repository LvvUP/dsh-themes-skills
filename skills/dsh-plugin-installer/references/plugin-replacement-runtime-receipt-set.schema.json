{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/dsh-plugin-alpha2-replacement-runtime-receipt-set-v1.json",
  "title": "Replacement Plugin six-task qualification summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "authorityEffect",
    "migrationMapSha256",
    "runtimePlanSha256",
    "baseline",
    "matrix",
    "ci",
    "observedPassedTaskReceipts",
    "qualifiedCandidateCount",
    "allocationCandidateCount",
    "candidates"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "replacement-runtime-allocation-threshold-met" },
    "authorityEffect": { "const": "candidate-qualification-only-never-install-authority" },
    "migrationMapSha256": { "$ref": "#/$defs/sha256" },
    "runtimePlanSha256": { "$ref": "#/$defs/sha256" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredTuples", "candidateCount", "tasksPerCandidate", "maximumTaskCount"],
      "properties": {
        "requiredTuples": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/tuple" }
        },
        "candidateCount": { "const": 44 },
        "tasksPerCandidate": { "const": 6 },
        "maximumTaskCount": { "const": 264 }
      }
    },
    "ci": { "$ref": "#/$defs/aggregateCi" },
    "observedPassedTaskReceipts": { "type": "integer", "minimum": 168, "maximum": 264 },
    "qualifiedCandidateCount": { "type": "integer", "minimum": 28, "maximum": 44 },
    "allocationCandidateCount": { "const": 28 },
    "candidates": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "items": { "$ref": "#/$defs/candidateSummary" }
    }
  },
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:#[A-Za-z0-9_./-]+)?$"
    },
    "candidateToken": {
      "type": "string",
      "pattern": "^replacement-(?:0[1-9]|[1-3][0-9]|4[0-4])-[a-f0-9]{20}$"
    },
    "tuple": {
      "enum": [
        "linux-x64-node-22.19.0",
        "linux-x64-node-24.15.0",
        "darwin-arm64-node-22.19.0",
        "darwin-arm64-node-24.15.0",
        "win32-x64-node-22.19.0",
        "win32-x64-node-24.15.0"
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit", "tree", "lockfileSha256"],
      "properties": {
        "tag": { "const": "dsh-v0.1.2-alpha.2" },
        "commit": { "const": "0a53fb55bea101816fa226bb964ae2bed71c343b" },
        "tree": { "const": "64ccbfa8e0caa4711cd4a75717ef9e022657961b" },
        "lockfileSha256": {
          "const": "6cc109a574218f51762474455c8d72e5f7c2625aedf25e85569dba1af7adcef0"
        }
      }
    },
    "aggregateCi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "workflowPath",
        "workflowSha256",
        "event",
        "ref",
        "runId",
        "runAttempt",
        "headSha",
        "jobKey"
      ],
      "properties": {
        "repository": { "const": "LvvUP/dsh-themes-skills" },
        "workflowPath": {
          "const": ".github/workflows/alpha2-plugin-replacement-runtime-certification.yml"
        },
        "workflowSha256": { "$ref": "#/$defs/sha256" },
        "event": { "const": "workflow_dispatch" },
        "ref": { "const": "refs/heads/main" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "runAttempt": { "type": "integer", "minimum": 1, "maximum": 100 },
        "headSha": { "$ref": "#/$defs/sha40" },
        "jobKey": { "const": "aggregate" }
      }
    },
    "candidateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migrationRank",
        "candidateKey",
        "candidateToken",
        "distributionClass",
        "passedTaskCount",
        "passedTuples",
        "taskReceiptSetSha256",
        "verifiedSixTask"
      ],
      "properties": {
        "migrationRank": { "type": "integer", "minimum": 1, "maximum": 44 },
        "candidateKey": { "$ref": "#/$defs/candidateKey" },
        "candidateToken": { "$ref": "#/$defs/candidateToken" },
        "distributionClass": {
          "enum": ["direct-upstream-exact", "hosted-adaptation-required"]
        },
        "passedTaskCount": { "type": "integer", "minimum": 0, "maximum": 6 },
        "passedTuples": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/tuple" }
        },
        "taskReceiptSetSha256": { "$ref": "#/$defs/sha256" },
        "verifiedSixTask": { "type": "boolean" }
      }
    }
  }
}
