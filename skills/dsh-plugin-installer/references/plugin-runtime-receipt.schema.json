{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/dsh-plugin-alpha1-runtime-receipt-v1.json",
  "title": "One isolated DSH Plugin alpha.1 runtime task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "scope",
    "runtimeCandidatePlanSha256",
    "candidate",
    "baseline",
    "task",
    "stages",
    "ci",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "plugin-runtime-task-passed" },
    "scope": { "const": "one-untrusted-candidate-one-platform-node-job" },
    "runtimeCandidatePlanSha256": { "$ref": "#/$defs/sha256" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogId", "slug", "repository", "commit", "tree", "sourceSubdir", "artifact"],
      "properties": {
        "catalogId": { "type": "integer", "minimum": 3000, "maximum": 3999 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "repository": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$" },
        "commit": { "$ref": "#/$defs/sha40" },
        "tree": { "$ref": "#/$defs/sha40" },
        "sourceSubdir": { "type": "string" },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator", "bytes", "sha256", "distribution"],
          "properties": {
            "kind": { "enum": ["npm-tarball", "github-release-asset", "hosted-staging-tarball"] },
            "locator": { "type": "string" },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "distribution": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceType", "immutableCoordinate", "metadataPath", "metadataSha256", "buildRecipePath", "buildRecipeSha256"],
              "properties": {
                "sourceType": { "enum": ["npm-registry-tarball", "github-release-asset", "reviewed-hosted-staging-build"] },
                "immutableCoordinate": { "type": "string" },
                "metadataPath": { "type": "string" },
                "metadataSha256": { "$ref": "#/$defs/sha256" },
                "buildRecipePath": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
                "buildRecipeSha256": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] }
              }
            }
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit", "tree", "lockfileSha256"],
      "properties": {
        "tag": { "const": "dsh-v0.1.2-alpha.1" },
        "commit": { "const": "cd5ef8148158c3a752a658978873241fdf8e2bbc" },
        "tree": { "const": "a712eec535b48badc4fefb4df5176a7002e4280b" },
        "lockfileSha256": { "const": "506ad1fc7c40f71ce8c6afe08724fdd55020c1a527d7a7a185c559d39ecfcaf1" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batchId", "platform", "arch", "nodeVersion"],
      "properties": {
        "batchId": { "type": "integer", "minimum": 1, "maximum": 4 },
        "platform": { "enum": ["linux", "darwin", "win32"] },
        "arch": { "enum": ["x64", "arm64"] },
        "nodeVersion": { "enum": ["22.19.0", "24.15.0"] }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "start", "functionalProbe", "remove", "fullRollback"],
      "properties": {
        "install": { "$ref": "#/$defs/install" },
        "start": { "$ref": "#/$defs/start" },
        "functionalProbe": { "$ref": "#/$defs/functionalProbe" },
        "remove": { "$ref": "#/$defs/remove" },
        "fullRollback": { "$ref": "#/$defs/fullRollback" }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflowPath", "workflowSha256", "event", "ref", "runId", "runAttempt", "headSha", "jobKey", "matrixIdentity"],
      "properties": {
        "repository": { "const": "LvvUP/dsh-themes-skills" },
        "workflowPath": { "const": ".github/workflows/alpha1-plugin-runtime-certification.yml" },
        "workflowSha256": { "$ref": "#/$defs/sha256" },
        "event": { "const": "workflow_dispatch" },
        "ref": { "const": "refs/heads/main" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "runAttempt": { "type": "integer", "minimum": 1, "maximum": 100 },
        "headSha": { "$ref": "#/$defs/sha40" },
        "jobKey": { "type": "string", "pattern": "^runtime-batch-[1-4]$" },
        "matrixIdentity": { "type": "string" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturesEnvironment", "capturesSecrets", "capturesBrowserCredentials", "capturesMachinePaths", "candidateReceiptsSharedAcrossJobs"],
      "properties": {
        "capturesEnvironment": { "const": false },
        "capturesSecrets": { "const": false },
        "capturesBrowserCredentials": { "const": false },
        "capturesMachinePaths": { "const": false },
        "candidateReceiptsSharedAcrossJobs": { "const": false }
      }
    }
  },
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "passed": { "const": "passed" },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "candidateArtifactSha256", "candidateArtifactBytes", "packageName", "version", "profileBeforeSha256", "profileAfterInstallSha256", "dumpConfigSha256"],
      "properties": {
        "status": { "$ref": "#/$defs/passed" },
        "candidateArtifactSha256": { "$ref": "#/$defs/sha256" },
        "candidateArtifactBytes": { "type": "integer", "minimum": 1 },
        "packageName": { "type": "string" },
        "version": { "type": "string" },
        "profileBeforeSha256": { "$ref": "#/$defs/sha256" },
        "profileAfterInstallSha256": { "$ref": "#/$defs/sha256" },
        "dumpConfigSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "coldStart", "webBooted", "unauthenticatedRootStatus", "processStayedAlive"],
      "properties": {
        "status": { "$ref": "#/$defs/passed" },
        "coldStart": { "const": true },
        "webBooted": { "const": true },
        "unauthenticatedRootStatus": { "const": 401 },
        "processStayedAlive": { "const": true }
      }
    },
    "functionalProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "kind", "contractSha256", "webBootOnly", "assertions"],
      "properties": {
        "status": { "$ref": "#/$defs/passed" },
        "kind": { "const": "candidate-capability-contract" },
        "contractSha256": { "$ref": "#/$defs/sha256" },
        "webBootOnly": { "const": false },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "evidenceSha256"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
              "status": { "const": "passed" },
              "evidenceSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "remove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exactPackageAbsent", "cordisEntryAbsent", "profileAfterRemoveSha256"],
      "properties": {
        "status": { "$ref": "#/$defs/passed" },
        "exactPackageAbsent": { "const": true },
        "cordisEntryAbsent": { "const": true },
        "profileAfterRemoveSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fullRollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "isolatedDshHomeBeforeSha256", "isolatedDshHomeAfterSha256", "dependencyClosureBeforeSha256", "dependencyClosureAfterSha256", "declaredWritableRoots", "observedWritableRoots", "allDshHomeBytesRestored", "dependencyClosureRestored", "noWritesOutsideDeclaredRoots", "sandboxedExternalWritesDenied", "sidecarsTerminated"],
      "properties": {
        "status": { "$ref": "#/$defs/passed" },
        "isolatedDshHomeBeforeSha256": { "$ref": "#/$defs/sha256" },
        "isolatedDshHomeAfterSha256": { "$ref": "#/$defs/sha256" },
        "dependencyClosureBeforeSha256": { "$ref": "#/$defs/sha256" },
        "dependencyClosureAfterSha256": { "$ref": "#/$defs/sha256" },
        "declaredWritableRoots": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string" } },
        "observedWritableRoots": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string" } },
        "allDshHomeBytesRestored": { "const": true },
        "dependencyClosureRestored": { "const": true },
        "noWritesOutsideDeclaredRoots": { "const": true },
        "sandboxedExternalWritesDenied": { "const": true },
        "sidecarsTerminated": { "const": true }
      }
    }
  }
}
