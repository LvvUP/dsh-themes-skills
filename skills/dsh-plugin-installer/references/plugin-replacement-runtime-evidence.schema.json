{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/dsh-plugin-alpha2-replacement-runtime-evidence-v1.json",
  "title": "Durable replacement runtime evidence predicate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predicateType",
    "migrationMapSha256",
    "runtimePlanSha256",
    "receiptSetSha256",
    "proposalSha256",
    "receipts"
  ],
  "properties": {
    "predicateType": {
      "const": "https://dsh-themes.com/attestations/plugin-alpha2-replacement-runtime-evidence/v1"
    },
    "migrationMapSha256": { "$ref": "#/$defs/sha256" },
    "runtimePlanSha256": { "$ref": "#/$defs/sha256" },
    "receiptSetSha256": { "$ref": "#/$defs/sha256" },
    "proposalSha256": { "$ref": "#/$defs/sha256" },
    "receipts": {
      "type": "array",
      "minItems": 168,
      "maxItems": 264,
      "items": {
        "$ref": "plugin-replacement-runtime-receipt.schema.json"
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
