{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/plugin-hosted-adaptation-v1.json",
  "title": "DSH alpha.1 hosted Plugin adaptation recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "purpose",
    "catalogId",
    "slug",
    "baseline",
    "source",
    "output",
    "rights",
    "staticPolicy",
    "runtimeProbe"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "purpose": { "const": "dsh-alpha1-hosted-plugin-adaptation" },
    "catalogId": { "type": "integer", "minimum": 3000, "maximum": 9999 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit", "tree"],
      "properties": {
        "tag": { "const": "dsh-v0.1.2-alpha.1" },
        "commit": { "const": "cd5ef8148158c3a752a658978873241fdf8e2bbc" },
        "tree": { "const": "a712eec535b48badc4fefb4df5176a7002e4280b" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree",
        "sourceSubdir",
        "manifestSha256",
        "packageName",
        "packageVersion",
        "bundlePatch"
      ],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$" },
        "commit": { "$ref": "#/$defs/sha40" },
        "tree": { "$ref": "#/$defs/sha40" },
        "sourceSubdir": { "const": "." },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "packageName": { "$ref": "#/$defs/packageName" },
        "packageVersion": { "$ref": "#/$defs/semver" },
        "bundlePatch": { "$ref": "#/$defs/path" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "packageVersion", "description", "assetName", "hostEntry", "clientEntry", "bundlePatch", "clientInject", "peerDependencies", "files"],
      "properties": {
        "packageName": { "$ref": "#/$defs/packageName" },
        "packageVersion": { "$ref": "#/$defs/semver" },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "assetName": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.tgz$" },
        "hostEntry": { "$ref": "#/$defs/scriptEntryPath" },
        "clientEntry": { "$ref": "#/$defs/scriptEntryPath" },
        "bundlePatch": { "$ref": "#/$defs/path" },
        "clientInject": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dependencyName" }
        },
        "peerDependencies": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "$ref": "#/$defs/dependencyName" },
          "additionalProperties": { "$ref": "#/$defs/semver" }
        },
        "files": {
          "type": "array",
          "minItems": 3,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/file" }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["licenseExpression", "licensePath", "licenseSha256", "copyrightNotice", "redistribution"],
      "properties": {
        "licenseExpression": { "enum": ["MIT", "Apache-2.0", "BSD-3-Clause", "AGPL-3.0"] },
        "licensePath": { "$ref": "#/$defs/path" },
        "licenseSha256": { "$ref": "#/$defs/sha256" },
        "copyrightNotice": { "type": "string", "minLength": 1, "maxLength": 300 },
        "redistribution": { "const": "allowed-with-license-and-modification-notice" }
      }
    },
    "staticPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["computedMembers", "forbiddenUtf8", "requiredUtf8"],
      "properties": {
        "computedMembers": {
          "type": "array",
          "maxItems": 0,
          "items": { "$ref": "#/$defs/computedMember" }
        },
        "forbiddenUtf8": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "requiredUtf8": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "runtimeProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractPath", "contractSha256", "requiredAssertions"],
      "properties": {
        "contractPath": {
          "type": "string",
          "pattern": "^references/plugin-runtime-probes/[0-9]{4}\\.json$"
        },
        "contractSha256": { "$ref": "#/$defs/sha256" },
        "requiredAssertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
          }
        }
      }
    }
  },
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "packageName": { "type": "string", "pattern": "^(?:@[a-z0-9._-]+/)?[a-z0-9._-]+$" },
    "dependencyName": {
      "allOf": [
        { "$ref": "#/$defs/packageName" },
        { "not": { "enum": ["constructor", "__proto__", "prototype"] } }
      ]
    },
    "path": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^(?:[A-Za-z0-9_-](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?/)*[A-Za-z0-9_-](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$"
    },
    "scriptEntryPath": {
      "allOf": [
        { "$ref": "#/$defs/path" },
        { "pattern": "\\.(?:js|mjs|cjs)$" }
      ]
    },
    "computedMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputPath", "expression", "occurrences"],
      "properties": {
        "outputPath": { "$ref": "#/$defs/scriptEntryPath" },
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "occurrences": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputPath", "input"],
      "properties": {
        "outputPath": { "$ref": "#/$defs/path" },
        "input": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "sourcePath", "sha256"],
              "properties": {
                "kind": { "const": "copy-exact-upstream" },
                "sourcePath": { "$ref": "#/$defs/path" },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "sourcePath", "sourceSha256", "replacementPath", "replacementSha256"],
              "properties": {
                "kind": { "const": "reviewed-replacement" },
                "sourcePath": { "$ref": "#/$defs/path" },
                "sourceSha256": { "$ref": "#/$defs/sha256" },
                "replacementPath": { "$ref": "#/$defs/path" },
                "replacementSha256": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        }
      }
    }
  }
}
