{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/dsh-plugin-top10-score-authority-v1.json",
  "title": "DSH Plugin Top10 complete score authority",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "frozen": { "const": true } }, "required": ["frozen"] },
      "then": { "properties": { "items": { "minItems": 80, "maxItems": 80 } } },
      "else": { "properties": { "items": { "maxItems": 0 } }
      }
    }
  ],
  "required": [
    "schemaVersion",
    "capturedAt",
    "purpose",
    "status",
    "frozen",
    "baseline",
    "candidateIntake",
    "scoring",
    "pluginSet",
    "items",
    "scoreAuthorityPayloadSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capturedAt": { "type": "string", "format": "date" },
    "purpose": { "const": "dsh-plugin-top10-score-authority" },
    "status": { "enum": ["candidate-pending", "verified-frozen"] },
    "frozen": { "type": "boolean" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "candidateIntake": { "$ref": "#/$defs/candidateIntake" },
    "scoring": { "$ref": "#/$defs/scoring" },
    "pluginSet": { "$ref": "#/$defs/pluginSet" },
    "items": {
      "type": "array",
      "maxItems": 80,
      "items": { "$ref": "#/$defs/item" }
    },
    "scoreAuthorityPayloadSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit"],
      "properties": {
        "tag": { "const": "dsh-v0.1.2-alpha.2" },
        "commit": { "const": "0a53fb55bea101816fa226bb964ae2bed71c343b" }
      }
    },
    "candidateIntake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "requiredItemCount"],
      "properties": {
        "path": { "const": "plugin-candidate-intake.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "requiredItemCount": { "const": 80 }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userValueAndUseCaseClarity",
        "stabilityMaintenanceAndAlpha2Fit",
        "securityAndPermissionRestraint",
        "crossPlatformInstallRemoveRollback",
        "nonTechnicalUsabilityAndDocs",
        "combinationComplementarity"
      ],
      "properties": {
        "userValueAndUseCaseClarity": { "const": 25 },
        "stabilityMaintenanceAndAlpha2Fit": { "const": 25 },
        "securityAndPermissionRestraint": { "const": 15 },
        "crossPlatformInstallRemoveRollback": { "const": 15 },
        "nonTechnicalUsabilityAndDocs": { "const": 10 },
        "combinationComplementarity": { "const": 10 }
      }
    },
    "useCase": {
      "enum": [
        "build-and-review",
        "collaborate-and-notify",
        "discover-and-start",
        "govern-and-secure",
        "measure-and-optimize",
        "navigate-and-focus",
        "plan-and-automate",
        "remember-and-retrieve",
        "research-the-web",
        "see-and-understand"
      ]
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weights",
        "minimumUseCaseCategories",
        "useCaseCategories",
        "tieBreakOrder"
      ],
      "properties": {
        "weights": { "$ref": "#/$defs/weights" },
        "minimumUseCaseCategories": { "const": 8 },
        "useCaseCategories": {
          "const": [
            "build-and-review",
            "collaborate-and-notify",
            "discover-and-start",
            "govern-and-secure",
            "measure-and-optimize",
            "navigate-and-focus",
            "plan-and-automate",
            "remember-and-retrieve",
            "research-the-web",
            "see-and-understand"
          ]
        },
        "tieBreakOrder": {
          "const": [
            "stability-plus-security",
            "maintenance-activity",
            "lower-public-id"
          ]
        }
      }
    },
    "pluginSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredItemCount", "verifiedItemCount", "itemAuthoritySetSha256"],
      "properties": {
        "requiredItemCount": { "const": 80 },
        "verifiedItemCount": { "type": "integer", "minimum": 0, "maximum": 80 },
        "itemAuthoritySetSha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userValueAndUseCaseClarity",
        "stabilityMaintenanceAndAlpha2Fit",
        "securityAndPermissionRestraint",
        "crossPlatformInstallRemoveRollback",
        "nonTechnicalUsabilityAndDocs",
        "combinationComplementarity"
      ],
      "properties": {
        "userValueAndUseCaseClarity": { "type": "integer", "minimum": 0, "maximum": 25 },
        "stabilityMaintenanceAndAlpha2Fit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "securityAndPermissionRestraint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "crossPlatformInstallRemoveRollback": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "nonTechnicalUsabilityAndDocs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "combinationComplementarity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "maintenanceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repository",
        "commit",
        "committedAt",
        "observedAt",
        "evidenceUrl",
        "sourceResponseSha256"
      ],
      "properties": {
        "kind": { "const": "github-commit-metadata" },
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"
        },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "committedAt": { "type": "string", "format": "date-time" },
        "observedAt": { "type": "string", "format": "date-time" },
        "evidenceUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/commit/[a-f0-9]{40}$"
        },
        "sourceResponseSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scoreReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "purpose",
        "capturedAt",
        "baselineCommit",
        "catalogId",
        "candidateInputSha256",
        "itemAuthoritySha256",
        "platformNodeMatrixSha256",
        "scoringPolicySha256",
        "useCaseCategories",
        "scores",
        "totalScore",
        "maintenanceEvidenceSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "purpose": { "const": "dsh-plugin-top10-score-review" },
        "capturedAt": { "type": "string", "format": "date" },
        "baselineCommit": { "const": "0a53fb55bea101816fa226bb964ae2bed71c343b" },
        "catalogId": { "type": "integer", "minimum": 3000, "maximum": 3999 },
        "candidateInputSha256": { "$ref": "#/$defs/sha256" },
        "itemAuthoritySha256": { "$ref": "#/$defs/sha256" },
        "platformNodeMatrixSha256": { "$ref": "#/$defs/sha256" },
        "scoringPolicySha256": { "$ref": "#/$defs/sha256" },
        "useCaseCategories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/useCase" }
        },
        "scores": { "$ref": "#/$defs/scores" },
        "totalScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "maintenanceEvidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogId",
        "publicId",
        "candidateInputSha256",
        "itemAuthoritySha256",
        "useCaseCategories",
        "scores",
        "totalScore",
        "maintenanceEvidence",
        "scoreReceipt",
        "scoreReceiptSha256"
      ],
      "properties": {
        "catalogId": { "type": "integer", "minimum": 3000, "maximum": 3999 },
        "publicId": { "type": "string", "pattern": "^#3[0-9]{3}$" },
        "candidateInputSha256": { "$ref": "#/$defs/sha256" },
        "itemAuthoritySha256": { "$ref": "#/$defs/sha256" },
        "useCaseCategories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/useCase" }
        },
        "scores": { "$ref": "#/$defs/scores" },
        "totalScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "maintenanceEvidence": { "$ref": "#/$defs/maintenanceEvidence" },
        "scoreReceipt": { "$ref": "#/$defs/scoreReceipt" },
        "scoreReceiptSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
