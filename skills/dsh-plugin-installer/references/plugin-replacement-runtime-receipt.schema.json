{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/dsh-plugin-alpha2-replacement-runtime-receipt-v1.json",
  "title": "One passed ID-less replacement Plugin runtime task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "scope",
    "authorityEffect",
    "migrationMapSha256",
    "runtimePlanSha256",
    "candidate",
    "baseline",
    "task",
    "stages",
    "ci",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "replacement-runtime-task-passed" },
    "scope": { "const": "one-idless-candidate-one-platform-node-task" },
    "authorityEffect": { "const": "one-of-six-candidate-evidence-only" },
    "migrationMapSha256": { "$ref": "#/$defs/sha256" },
    "runtimePlanSha256": { "$ref": "#/$defs/sha256" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "task": { "$ref": "#/$defs/task" },
    "stages": { "$ref": "#/$defs/stages" },
    "ci": { "$ref": "#/$defs/ci" },
    "privacy": { "$ref": "#/$defs/privacy" }
  },
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:#[A-Za-z0-9_./-]+)?$"
    },
    "candidateToken": {
      "type": "string",
      "pattern": "^replacement-(?:0[1-9]|[1-3][0-9]|4[0-4])-[a-f0-9]{20}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "sourceSubdir", "exactCoordinate"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"
        },
        "commit": { "$ref": "#/$defs/sha40" },
        "tree": { "$ref": "#/$defs/sha40" },
        "sourceSubdir": { "type": "string", "minLength": 1, "maxLength": 240 },
        "exactCoordinate": { "type": "string", "minLength": 3, "maxLength": 500 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locator",
        "bytes",
        "sha256",
        "metadataPath",
        "metadataSha256",
        "buildRecipePath",
        "buildRecipeSha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "upstream-npm-tarball",
            "upstream-github-release-asset",
            "hosted-adaptation-staging-tarball"
          ]
        },
        "locator": { "type": "string", "minLength": 3, "maxLength": 500 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "metadataPath": { "type": "string", "minLength": 1, "maxLength": 300 },
        "metadataSha256": { "$ref": "#/$defs/sha256" },
        "buildRecipePath": {
          "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 300 }]
        },
        "buildRecipeSha256": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migrationRank",
        "candidateKey",
        "candidateToken",
        "packageName",
        "packageVersion",
        "distributionClass",
        "source",
        "artifact"
      ],
      "properties": {
        "migrationRank": { "type": "integer", "minimum": 1, "maximum": 44 },
        "candidateKey": { "$ref": "#/$defs/candidateKey" },
        "candidateToken": { "$ref": "#/$defs/candidateToken" },
        "packageName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "packageVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "distributionClass": {
          "enum": ["direct-upstream-exact", "hosted-adaptation-required"]
        },
        "source": { "$ref": "#/$defs/source" },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit", "tree", "lockfileSha256"],
      "properties": {
        "tag": { "const": "dsh-v0.1.2-alpha.2" },
        "commit": { "const": "0a53fb55bea101816fa226bb964ae2bed71c343b" },
        "tree": { "const": "64ccbfa8e0caa4711cd4a75717ef9e022657961b" },
        "lockfileSha256": {
          "const": "6cc109a574218f51762474455c8d72e5f7c2625aedf25e85569dba1af7adcef0"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batchId", "platform", "arch", "nodeVersion"],
      "properties": {
        "batchId": { "type": "integer", "minimum": 1, "maximum": 4 },
        "platform": { "enum": ["linux", "darwin", "win32"] },
        "arch": { "enum": ["x64", "arm64"] },
        "nodeVersion": { "enum": ["22.19.0", "24.15.0"] }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "status": { "const": "passed" }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "start", "functionalProbe", "remove", "fullRollback"],
      "properties": {
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "candidateArtifactSha256",
            "candidateArtifactBytes",
            "packageName",
            "version",
            "profileSnapshotCaptured",
            "sanitizedDumpConfigEntrySetSha256",
            "exactCordisEntryPresent"
          ],
          "properties": {
            "status": { "const": "passed" },
            "candidateArtifactSha256": { "$ref": "#/$defs/sha256" },
            "candidateArtifactBytes": { "type": "integer", "minimum": 1 },
            "packageName": { "type": "string", "minLength": 1, "maxLength": 120 },
            "version": { "type": "string", "minLength": 1, "maxLength": 80 },
            "profileSnapshotCaptured": { "const": true },
            "sanitizedDumpConfigEntrySetSha256": { "$ref": "#/$defs/sha256" },
            "exactCordisEntryPresent": { "const": true }
          }
        },
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "coldStart",
            "webBooted",
            "unauthenticatedRootStatus",
            "processStayedAlive"
          ],
          "properties": {
            "status": { "const": "passed" },
            "coldStart": { "const": true },
            "webBooted": { "const": true },
            "unauthenticatedRootStatus": { "const": 401 },
            "processStayedAlive": { "const": true }
          }
        },
        "functionalProbe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "kind", "contractSha256", "webBootOnly", "assertions"],
          "properties": {
            "status": { "const": "passed" },
            "kind": { "const": "candidate-capability-contract" },
            "contractSha256": { "$ref": "#/$defs/sha256" },
            "webBootOnly": { "const": false },
            "assertions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/assertion" }
            }
          }
        },
        "remove": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "exactPackageAbsent", "cordisEntryAbsent", "sanitizedDumpConfigEntrySetSha256"],
          "properties": {
            "status": { "const": "passed" },
            "exactPackageAbsent": { "const": true },
            "cordisEntryAbsent": { "const": true },
            "sanitizedDumpConfigEntrySetSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "fullRollback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "declaredWritableRoots",
            "observedWritableRoots",
            "allDshHomeBytesRestored",
            "dependencyClosureRestored",
            "noWritesOutsideDeclaredRoots",
            "sandboxedExternalWritesDenied",
            "sidecarsTerminated"
          ],
          "properties": {
            "status": { "const": "passed" },
            "declaredWritableRoots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/safeId" }
            },
            "observedWritableRoots": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/safeId" }
            },
            "allDshHomeBytesRestored": { "const": true },
            "dependencyClosureRestored": { "const": true },
            "noWritesOutsideDeclaredRoots": { "const": true },
            "sandboxedExternalWritesDenied": { "const": true },
            "sidecarsTerminated": { "const": true }
          }
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "workflowPath",
        "workflowSha256",
        "event",
        "ref",
        "runId",
        "runAttempt",
        "headSha",
        "jobKey",
        "matrixIdentity"
      ],
      "properties": {
        "repository": { "const": "LvvUP/dsh-themes-skills" },
        "workflowPath": {
          "const": ".github/workflows/alpha2-plugin-replacement-runtime-certification.yml"
        },
        "workflowSha256": { "$ref": "#/$defs/sha256" },
        "event": { "const": "workflow_dispatch" },
        "ref": { "const": "refs/heads/main" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "runAttempt": { "type": "integer", "minimum": 1, "maximum": 100 },
        "headSha": { "$ref": "#/$defs/sha40" },
        "jobKey": { "type": "string", "pattern": "^runtime-batch-[1-4]$" },
        "matrixIdentity": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capturesEnvironment",
        "capturesSecrets",
        "capturesBrowserCredentials",
        "capturesMachinePaths",
        "capturesCandidateOutput",
        "capturesSecretDerivedDigests"
      ],
      "properties": {
        "capturesEnvironment": { "const": false },
        "capturesSecrets": { "const": false },
        "capturesBrowserCredentials": { "const": false },
        "capturesMachinePaths": { "const": false },
        "capturesCandidateOutput": { "const": false },
        "capturesSecretDerivedDigests": { "const": false }
      }
    }
  }
}
