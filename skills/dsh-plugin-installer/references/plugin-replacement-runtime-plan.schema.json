{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/dsh-plugin-alpha2-replacement-runtime-plan-v1.json",
  "title": "ID-less alpha.2 Plugin replacement runtime plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "purpose",
    "status",
    "authorityEffect",
    "migrationMapSha256",
    "migrationMapSchemaSha256",
    "harnessReleaseAuthoritySha256",
    "baseline",
    "matrix",
    "allocationPolicy",
    "candidates"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "purpose": { "const": "dsh-plugin-alpha2-replacement-runtime-plan" },
    "status": {
      "enum": ["runtime-input-authority-pending", "runtime-candidates-ready"]
    },
    "authorityEffect": {
      "const": "candidate-evidence-only-never-install-authority"
    },
    "migrationMapSha256": {
      "const": "d113a04a1d64ceeea6068624433ef60fe5e192c0ccecd1a39b76d31f5c802005"
    },
    "migrationMapSchemaSha256": {
      "const": "48ceef982d6a86856c925c1cec3d319c00d2ec3809383b7c7d200afcc88a87a3"
    },
    "harnessReleaseAuthoritySha256": {
      "const": "f8be99bda583c2b8b1458746eaf07fe64c5a846348cbe0fffc1d4ff699211e11"
    },
    "baseline": { "$ref": "#/$defs/baseline" },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batchCount",
        "candidatesPerBatch",
        "tasksPerCandidate",
        "totalCandidates",
        "totalTasks"
      ],
      "properties": {
        "batchCount": { "const": 4 },
        "candidatesPerBatch": { "const": 11 },
        "tasksPerCandidate": { "const": 6 },
        "totalCandidates": { "const": 44 },
        "totalTasks": { "const": 264 }
      }
    },
    "allocationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateKeysArePublicIds",
        "allocateOnlyAfterSixTaskPass",
        "firstPublicId",
        "requiredAllocationCount",
        "retiredPublicIds",
        "retiredIdsMayBeRebound",
        "writesPluginAuthorityItems"
      ],
      "properties": {
        "candidateKeysArePublicIds": { "const": false },
        "allocateOnlyAfterSixTaskPass": { "const": true },
        "firstPublicId": { "const": 3089 },
        "requiredAllocationCount": { "const": 28 },
        "retiredPublicIds": {
          "type": "array",
          "minItems": 28,
          "maxItems": 28,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 3000, "maximum": 3088 }
        },
        "retiredIdsMayBeRebound": { "const": false },
        "writesPluginAuthorityItems": { "const": false }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:#[A-Za-z0-9_./-]+)?$"
    },
    "candidateToken": {
      "type": "string",
      "pattern": "^replacement-(?:0[1-9]|[1-3][0-9]|4[0-4])-[a-f0-9]{20}$"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit", "tree", "lockfileSha256"],
      "properties": {
        "tag": { "const": "dsh-v0.1.2-alpha.2" },
        "commit": { "const": "0a53fb55bea101816fa226bb964ae2bed71c343b" },
        "tree": { "const": "64ccbfa8e0caa4711cd4a75717ef9e022657961b" },
        "lockfileSha256": {
          "const": "6cc109a574218f51762474455c8d72e5f7c2625aedf25e85569dba1af7adcef0"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree",
        "sourceSubdir",
        "exactCoordinate"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"
        },
        "commit": { "$ref": "#/$defs/sha40" },
        "tree": { "$ref": "#/$defs/sha40" },
        "sourceSubdir": {
          "type": "string",
          "pattern": "^(?:\\.|[A-Za-z0-9_-]+(?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:/[A-Za-z0-9_-]+(?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*)$"
        },
        "exactCoordinate": { "type": "string", "minLength": 3, "maxLength": 500 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locator",
        "bytes",
        "sha256",
        "metadataPath",
        "metadataSha256",
        "buildRecipePath",
        "buildRecipeSha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "upstream-npm-tarball",
            "upstream-github-release-asset",
            "hosted-adaptation-staging-tarball"
          ]
        },
        "locator": { "type": "string", "minLength": 3, "maxLength": 500 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "metadataPath": { "type": "string", "minLength": 1, "maxLength": 300 },
        "metadataSha256": { "$ref": "#/$defs/sha256" },
        "buildRecipePath": {
          "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 300 }]
        },
        "buildRecipeSha256": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        }
      }
    },
    "functionalProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractPath", "contractSha256", "requiredAssertions"],
      "properties": {
        "contractPath": { "type": "string", "minLength": 1, "maxLength": 300 },
        "contractSha256": { "$ref": "#/$defs/sha256" },
        "requiredAssertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
          }
        }
      }
    },
    "runtimeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "functionalProbe"],
      "properties": {
        "artifact": { "$ref": "#/$defs/artifact" },
        "functionalProbe": { "$ref": "#/$defs/functionalProbe" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "candidateKey",
        "candidateToken",
        "packageName",
        "packageVersion",
        "distributionClass",
        "source",
        "status",
        "runtimeInput"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 44 },
        "candidateKey": { "$ref": "#/$defs/candidateKey" },
        "candidateToken": { "$ref": "#/$defs/candidateToken" },
        "packageName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "packageVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "distributionClass": {
          "enum": ["direct-upstream-exact", "hosted-adaptation-required"]
        },
        "source": { "$ref": "#/$defs/source" },
        "status": {
          "enum": ["runtime-input-pending", "runtime-candidate-ready"]
        },
        "runtimeInput": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/runtimeInput" }]
        }
      }
    }
  }
}
