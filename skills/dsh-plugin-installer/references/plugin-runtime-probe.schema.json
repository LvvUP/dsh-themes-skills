{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/plugin-runtime-probe-v1.json",
  "title": "DSH alpha.1 Plugin fixed runtime probe contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "purpose",
    "authorityEffect",
    "candidateExecuted",
    "catalogId",
    "baseline",
    "package",
    "capabilities",
    "combination",
    "assertions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "purpose": { "const": "dsh-plugin-alpha1-fixed-runtime-probe" },
    "authorityEffect": { "const": "contract-only-not-runtime-authority" },
    "candidateExecuted": { "const": false },
    "catalogId": { "type": "integer", "minimum": 3000, "maximum": 9999 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit", "tree"],
      "properties": {
        "tag": { "const": "dsh-v0.1.2-alpha.1" },
        "commit": { "const": "cd5ef8148158c3a752a658978873241fdf8e2bbc" },
        "tree": { "const": "a712eec535b48badc4fefb4df5176a7002e4280b" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "profile", "cordisEntryId"],
      "properties": {
        "name": { "$ref": "#/$defs/packageName" },
        "version": { "$ref": "#/$defs/semver" },
        "profile": { "const": "web" },
        "cordisEntryId": { "$ref": "#/$defs/safeId" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permissions",
        "network",
        "processes",
        "files",
        "clientServices",
        "remoteMethods",
        "browserPersistence"
      ],
      "properties": {
        "permissions": { "$ref": "#/$defs/boundedStrings" },
        "network": { "$ref": "#/$defs/boundedStrings" },
        "processes": { "$ref": "#/$defs/boundedStrings" },
        "files": { "$ref": "#/$defs/boundedStrings" },
        "clientServices": { "$ref": "#/$defs/boundedStrings" },
        "remoteMethods": { "$ref": "#/$defs/boundedStrings" },
        "browserPersistence": { "enum": ["none", "settings-scope-only"] }
      }
    },
    "combination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["additiveSlots", "exclusiveResources", "officialSurfacePreserved"],
      "properties": {
        "additiveSlots": { "$ref": "#/$defs/boundedStrings" },
        "exclusiveResources": { "$ref": "#/$defs/boundedStrings" },
        "officialSurfacePreserved": { "type": "boolean" }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "expected"],
        "properties": {
          "id": { "$ref": "#/$defs/safeId" },
          "class": {
            "enum": [
              "package-graph",
              "cold-web-boot",
              "feature-contract",
              "security-boundary",
              "accessibility-responsive",
              "teardown-rollback",
              "combination"
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "packageName": {
      "type": "string",
      "pattern": "^(?:@[a-z0-9._-]+/)?[a-z0-9._-]+$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
    },
    "boundedStrings": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    }
  }
}
