{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/dsh-plugin-top10-release-set-v1.json",
  "title": "DSH Plugin Top10 release set",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "frozen": { "const": true } }, "required": ["frozen"] },
      "then": { "properties": { "entries": { "minItems": 10, "maxItems": 10 } } },
      "else": { "properties": { "entries": { "maxItems": 0 } } }
    }
  ],
  "required": ["schemaVersion", "capturedAt", "purpose", "releaseSet", "status", "frozen", "baseline", "scoring", "entries", "gate", "releaseSetPayloadSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capturedAt": { "type": "string", "format": "date" },
    "purpose": { "const": "dsh-plugin-top10-release-set" },
    "releaseSet": { "type": "string", "pattern": "^[a-z0-9-]{8,80}$" },
    "status": { "enum": ["candidate-pending", "verified-frozen"] },
    "frozen": { "type": "boolean" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "scoring": { "$ref": "#/$defs/scoring" },
    "entries": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/entry" } },
    "gate": { "$ref": "#/$defs/gate" },
    "releaseSetPayloadSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit"],
      "properties": {
        "tag": { "const": "dsh-v0.1.2-alpha.1" },
        "commit": { "const": "cd5ef8148158c3a752a658978873241fdf8e2bbc" }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userValueAndUseCaseClarity", "stabilityMaintenanceAndAlpha1Fit", "securityAndPermissionRestraint", "crossPlatformInstallRemoveRollback", "nonTechnicalUsabilityAndDocs", "combinationComplementarity"],
      "properties": {
        "userValueAndUseCaseClarity": { "const": 25 },
        "stabilityMaintenanceAndAlpha1Fit": { "const": 25 },
        "securityAndPermissionRestraint": { "const": 15 },
        "crossPlatformInstallRemoveRollback": { "const": 15 },
        "nonTechnicalUsabilityAndDocs": { "const": 10 },
        "combinationComplementarity": { "const": 10 }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weights", "minimumUseCaseCategories", "coveredUseCaseCategories", "coverageStatus", "tieBreakOrder"],
      "properties": {
        "weights": { "$ref": "#/$defs/weights" },
        "minimumUseCaseCategories": { "const": 8 },
        "coveredUseCaseCategories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]{3,48}$" } },
        "coverageStatus": { "enum": ["candidate-unverified", "verified"] },
        "tieBreakOrder": { "const": ["stability-plus-security", "maintenance-activity", "lower-public-id"] }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "publicId", "catalogId", "itemAuthoritySha256", "useCaseCategories", "scores", "totalScore", "maintenanceActivityAt", "maintenanceActivityReceiptSha256"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 10 },
        "publicId": { "type": "string", "pattern": "^#3[0-9]{3}$" },
        "catalogId": { "type": "integer", "minimum": 3000, "maximum": 3999 },
        "itemAuthoritySha256": { "$ref": "#/$defs/sha256" },
        "useCaseCategories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]{3,48}$" } },
        "scores": { "$ref": "#/$defs/scores" },
        "totalScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "maintenanceActivityAt": { "type": "string", "format": "date" },
        "maintenanceActivityReceiptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userValueAndUseCaseClarity", "stabilityMaintenanceAndAlpha1Fit", "securityAndPermissionRestraint", "crossPlatformInstallRemoveRollback", "nonTechnicalUsabilityAndDocs", "combinationComplementarity"],
      "properties": {
        "userValueAndUseCaseClarity": { "type": "integer", "minimum": 0, "maximum": 25 },
        "stabilityMaintenanceAndAlpha1Fit": { "type": "integer", "minimum": 0, "maximum": 25 },
        "securityAndPermissionRestraint": { "type": "integer", "minimum": 0, "maximum": 15 },
        "crossPlatformInstallRemoveRollback": { "type": "integer", "minimum": 0, "maximum": 15 },
        "nonTechnicalUsabilityAndDocs": { "type": "integer", "minimum": 0, "maximum": 10 },
        "combinationComplementarity": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredPublishedPluginCount", "verifiedPluginCount", "requiredMatrixTasksPerItem", "verifiedMatrixTasksPerItem", "itemAuthorityComplete", "allEightyVerified", "sixTaskMatrixVerified", "transactionPreflightVerified", "transactionRollbackVerified", "webCoexistenceVerified", "conflictMatrixVerified", "transactionPreflightReceiptSha256", "transactionRollbackReceiptSha256", "webCoexistenceReceiptSha256", "conflictMatrixReceiptSha256", "itemAuthoritySetSha256", "platformNodeMatrixSetSha256"],
      "properties": {
        "requiredPublishedPluginCount": { "const": 80 },
        "verifiedPluginCount": { "type": "integer", "minimum": 0, "maximum": 80 },
        "requiredMatrixTasksPerItem": { "const": 6 },
        "verifiedMatrixTasksPerItem": { "type": "integer", "minimum": 0, "maximum": 6 },
        "itemAuthorityComplete": { "type": "boolean" },
        "allEightyVerified": { "type": "boolean" },
        "sixTaskMatrixVerified": { "type": "boolean" },
        "transactionPreflightVerified": { "type": "boolean" },
        "transactionRollbackVerified": { "type": "boolean" },
        "webCoexistenceVerified": { "type": "boolean" },
        "conflictMatrixVerified": { "type": "boolean" },
        "transactionPreflightReceiptSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "transactionRollbackReceiptSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "webCoexistenceReceiptSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "conflictMatrixReceiptSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "itemAuthoritySetSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "platformNodeMatrixSetSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    }
  }
}
