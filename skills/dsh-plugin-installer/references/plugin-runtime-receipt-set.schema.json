{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-themes.com/schemas/dsh-plugin-alpha1-runtime-receipt-set-v1.json",
  "title": "DSH Plugin alpha.1 80-of-80 runtime gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "authorityEffect",
    "runtimeCandidatePlanSha256",
    "baseline",
    "workflow",
    "gate",
    "batches",
    "candidates",
    "receiptSetPayloadSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "plugin-runtime-80-of-80-passed" },
    "authorityEffect": { "const": "none-awaiting-reviewed-promotion" },
    "runtimeCandidatePlanSha256": { "$ref": "#/$defs/sha256" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit", "tree", "lockfileSha256"],
      "properties": {
        "tag": { "const": "dsh-v0.1.2-alpha.1" },
        "commit": { "const": "cd5ef8148158c3a752a658978873241fdf8e2bbc" },
        "tree": { "const": "a712eec535b48badc4fefb4df5176a7002e4280b" },
        "lockfileSha256": { "const": "506ad1fc7c40f71ce8c6afe08724fdd55020c1a527d7a7a185c559d39ecfcaf1" }
      }
    },
    "workflow": { "$ref": "#/$defs/workflow" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredBatches", "verifiedBatches", "requiredCandidates", "verifiedCandidates", "requiredTasksPerCandidate", "verifiedTasks", "installStartFunctionalRemoveRollbackSeparated", "authorityBoundArtifactsAndFunctionalContracts", "completeIsolatedDshHomeRollback", "passed"],
      "properties": {
        "requiredBatches": { "const": 4 },
        "verifiedBatches": { "const": 4 },
        "requiredCandidates": { "const": 80 },
        "verifiedCandidates": { "const": 80 },
        "requiredTasksPerCandidate": { "const": 6 },
        "verifiedTasks": { "const": 480 },
        "installStartFunctionalRemoveRollbackSeparated": { "const": true },
        "authorityBoundArtifactsAndFunctionalContracts": { "const": true },
        "completeIsolatedDshHomeRollback": { "const": true },
        "passed": { "const": true }
      }
    },
    "batches": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/batch" } },
    "candidates": { "type": "array", "minItems": 80, "maxItems": 80, "items": { "$ref": "#/$defs/candidate" } },
    "receiptSetPayloadSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflowPath", "workflowSha256", "event", "ref", "runId", "runAttempt", "headSha"],
      "properties": {
        "repository": { "const": "LvvUP/dsh-themes-skills" },
        "workflowPath": { "const": ".github/workflows/alpha1-plugin-runtime-certification.yml" },
        "workflowSha256": { "$ref": "#/$defs/sha256" },
        "event": { "const": "workflow_dispatch" },
        "ref": { "const": "refs/heads/main" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "runAttempt": { "type": "integer", "minimum": 1, "maximum": 100 },
        "headSha": { "$ref": "#/$defs/sha40" }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batchId", "candidateCount", "taskCount", "receiptsSha256", "receipts"],
      "properties": {
        "batchId": { "type": "integer", "minimum": 1, "maximum": 4 },
        "candidateCount": { "const": 20 },
        "taskCount": { "const": 120 },
        "receiptsSha256": { "$ref": "#/$defs/sha256" },
        "receipts": {
          "type": "array",
          "minItems": 120,
          "maxItems": 120,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["catalogId", "tuple", "receiptSha256"],
            "properties": {
              "catalogId": { "type": "integer", "minimum": 3000, "maximum": 3999 },
              "tuple": { "type": "string" },
              "receiptSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogId", "slug", "sourceSubdir", "artifactSha256", "taskReceiptSha256"],
      "properties": {
        "catalogId": { "type": "integer", "minimum": 3000, "maximum": 3999 },
        "slug": { "type": "string" },
        "sourceSubdir": { "type": "string" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "taskReceiptSha256": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  }
}
